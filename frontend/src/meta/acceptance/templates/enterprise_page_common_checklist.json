    { "id": "COMMON-SECURITY-001", "family": "security", "name": "认证权限和危险动作受控", "requiredEvidence": ["authentication", "authorization", "dangerActionCount"], "executionType": "automatic" },
    { "id": "COMMON-DATA-001", "family": "data-protection", "name": "验收数据写入边界明确", "requiredEvidence": ["productionUserDataWritten", "businessWriteCount", "databaseHash"], "executionType": "automatic" },
    { "id": "COMMON-SCENARIO-001", "family": "scenario-query", "name": "页面场景参数生效且刷新保持", "requiredEvidence": ["queryParameters", "dataMode", "refreshPreserved"], "executionType": "automatic+manual" }
